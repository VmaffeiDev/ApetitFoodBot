TELEGRAM_BOT_TOKEN=cole_seu_token_novo_aqui

# Obrigatorio para liberar a administracao: publicar cardapio (mandar o arquivo
# para o bot), /importar, /pendencias, /alergenico, /cobertura, /relatorio,
# /atendimento e /avisar_favoritos.
# Vazio significa que ninguem tem acesso administrativo.
ADMIN_TELEGRAM_IDS=

APETIT_DB_PATH=apetit.db

# --------------------------------------------------------------------------
# Entrada no app web: e-mail e codigo de 6 digitos
# --------------------------------------------------------------------------

# Segredo do servidor usado para guardar o codigo como hash. Tem de ficar FORA
# do banco: e ele que impede que um banco vazado entregue as contas — seis
# digitos sao um milhao de possibilidades, e um hash sem segredo se quebra em
# segundos. Gere um novo e nao reaproveite de outro sistema:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = a entrada por codigo fica indisponivel (porta ausente, nao
# destrancada).
APETIT_SEGREDO=

# Por onde o codigo e enviado. Sem HOST e FROM, a rota de entrar responde
# indisponivel em vez de fingir que enviou.
APETIT_SMTP_HOST=
APETIT_SMTP_PORT=587
APETIT_SMTP_USER=
APETIT_SMTP_PASSWORD=
APETIT_SMTP_FROM=
APETIT_SMTP_TLS=1

# Token para a operacao publicar cardapio por HTTP (POST /api/cardapio).
# Vazio = a rota recusa tudo.
APETIT_PUBLICAR_TOKEN=

# Preenchido = webhook. Vazio = polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=telegram-webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=
PORT=8000
